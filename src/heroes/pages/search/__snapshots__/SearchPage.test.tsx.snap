// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`searchParamsPage > shoul render searchPage with default values 1`] = `
<div>
  <div
    data-testid="CustomJumbotron-id"
  />
  <nav
    aria-label="breadcrumb"
    class="mb-3"
    data-slot="breadcrumb"
  >
    <ol
      class="flex flex-wrap items-center gap-1.5 text-sm wrap-break-word text-muted-foreground"
      data-slot="breadcrumb-list"
    >
      <li
        class="inline-flex items-center gap-1"
        data-slot="breadcrumb-item"
      >
        <a
          data-discover="true"
          href="/"
        >
          Home
        </a>
      </li>
      <li
        aria-hidden="true"
        class="[&>svg]:size-3.5"
        data-slot="breadcrumb-separator"
        role="presentation"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-chevron-right"
          fill="none"
          height="24"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m9 18 6-6-6-6"
          />
        </svg>
      </li>
      <li
        class="inline-flex items-center gap-1"
        data-slot="breadcrumb-item"
      >
        <span
          aria-current="page"
          aria-disabled="true"
          class="font-normal text-foreground"
          data-slot="breadcrumb-page"
          role="link"
        >
          Search Superhero
        </span>
      </li>
    </ol>
  </nav>
  <div>
    Loading...
  </div>
  <div
    data-testid="SearchControls-id"
  />
  <div
    data-testid="hero-grid"
  />
</div>
`;

